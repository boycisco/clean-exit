# ===== Clean Exit backend =====
# Copy to .env and fill in. Never commit .env.

# --- App ---
APP_ENV=development
APP_HOST=127.0.0.1
APP_PORT=8000
APP_LOG_LEVEL=INFO
APP_CORS_ORIGINS=http://localhost:3000

# --- Database (SQLite for dev, PostgreSQL for prod) ---
DATABASE_URL=sqlite+aiosqlite:///./clean.db

# --- NEAR network ---
NEAR_NETWORK=testnet
NEAR_RPC_URL=https://rpc.testnet.near.org

# --- Signer (leave blank = read-only mode, destructive actions refuse) ---
NEAR_SIGNER_ACCOUNT=
NEAR_SIGNER_KEY_PATH=

# --- Receipt registry (leave blank until contract is deployed) ---
RECEIPT_CONTRACT=
RECEIPT_PUBLISHER_ACCOUNT=
RECEIPT_PUBLISHER_KEY_PATH=

# --- Bootstrap (first owner token; only used once) ---
BOOTSTRAP_TOKEN=

# --- Rate limits (requests/minute) ---
RATE_LIMIT_DEFAULT=60
RATE_LIMIT_DESTRUCTIVE=10